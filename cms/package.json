{
  "name": "itcom-cms",
  "private": true,
  "version": "2.0.0",
  "description": "ITCOM — CMS (admin) for the static shop, based on the Selca / Miftari Vision CMS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "site": "node scripts/itcom-catalog.mjs && tsc --noEmit && NO_HEADERS=1 BASE_PATH=/ITCOM/ vite build && node scripts/publish.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "three": "^0.160.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.2"
  }
}
